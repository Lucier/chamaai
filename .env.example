# ---- Banco de dados --------------------------------------------------------
# Usado por `npm run dev` / `npm run db:*` rodando fora do Docker (db exposto em localhost:5432).
DATABASE_URL=postgres://chamaai:chamaai@localhost:5432/chamaai

# Usados pelo docker compose para criar o Postgres.
POSTGRES_USER=chamaai
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=chamaai

# ---- Uploads ---------------------------------------------------------------
# Pasta onde as fotos dos prestadores são gravadas (no Docker é um volume).
UPLOAD_DIR=./uploads

# ---- Sessão do admin -------------------------------------------------------
# true quando o site é servido por HTTPS (recomendado em produção).
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
# Chave que assina o JWT da sessão (mínimo 32 caracteres). Gere uma só sua:
#   openssl rand -base64 48
# Trocar o valor desloga todos os admins. Nunca versione o valor real.
JWT_SECRET=…

# ---- HTTPS local (opcional) -------------------------------------------------
# Para instalar o PWA no celular: `bash scripts/https/setup.sh`, depois ligue o perfil abaixo.
# COMPOSE_PROFILES=https
# HTTPS_PORT=8443   # app por https
# CA_PORT=8080      # página para baixar o certificado da CA

# ---- Primeiro administrador ------------------------------------------------
# Lidos por `npm run admin:create` (o docker compose roda isso automaticamente).
# Senha nova: mínimo 10 caracteres (máx. 72 bytes), com letras e números, sem conter o e-mail.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
